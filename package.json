{
  "name": "design-notebook",
  "version": "0.10.0-first-look",
  "description": "A file-first workspace for prototypes, canvases, documents, and existing sites.",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "bin": {
    "design-notebook": "./bin/design-notebook.js"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "exports": {
    ".": "./index.js",
    "./runtime": {
      "types": "./index.d.ts",
      "import": "./src/core/runtime/index.js"
    },
    "./runtime/react": {
      "types": "./index.d.ts",
      "import": "./src/core/runtime/react.js"
    },
    "./runtime/route": {
      "types": "./index.d.ts",
      "import": "./src/core/runtime/route.js"
    },
    "./runtime/notebook-routes": {
      "types": "./index.d.ts",
      "import": "./src/core/runtime/notebook-routes.js"
    },
    "./docs": {
      "types": "./index.d.ts",
      "import": "./src/client/docs/index.js"
    },
    "./sites": {
      "types": "./index.d.ts",
      "import": "./src/client/sites/index.js"
    },
    "./shell": {
      "types": "./src/client/shell/index.d.ts",
      "import": "./src/client/shell/index.js"
    },
    "./schemas/*": "./schemas/artifacts/*"
  },
  "files": [
    "index.js",
    "index.d.ts",
    "README.md",
    "LICENSE",
    "LICENSES/",
    "examples/first-look/notebook/",
    "schemas/",
    "src/core/artifacts/",
    "src/core/docs/",
    "src/core/publisher/",
    "src/core/runtime/",
    "src/canvas-format/",
    "src/canvas-renderer/",
    "src/vendor/tiny-canvas/",
    "src/vendor/hypercanvas/",
    "src/client/docs/",
    "src/client/sites/",
    "src/client/shell/",
    "bin/",
    "docs/format/",
    "docs/release/0.10.0-first-look.md",
    "docs/getting-started.md",
    "docs/authoring.md",
    "docs/research/canvas-renderer-provenance.md",
    "skills/design-notebook-authoring/"
  ],
  "scripts": {
    "test": "node --test",
    "dev": "node ./bin/design-notebook.js dev ./example-notebook",
    "build": "node ./bin/design-notebook.js build",
    "example:init": "node ./bin/instantiate-example-notebook.js"
  },
  "license": "MIT",
  "dependencies": {
    "@base-ui/react": "^1.4.0",
    "@dfosco/statefully": "0.2.1",
    "@mdx-js/mdx": "3.1.1",
    "@mdx-js/react": "3.1.1",
    "@tailwindcss/node": "4.2.2",
    "@tailwindcss/oxide": "4.2.2",
    "@vitejs/plugin-react": "5.2.0",
    "ajv": "^8.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.54.0",
    "postcss": "8.5.29",
    "postcss-selector-parser": "7.1.6",
    "postcss-value-parser": "4.2.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "4.2.2",
    "tw-animate-css": "1.4.0",
    "vite": "7.3.7",
    "yaml": "^2.9.1"
  }
}
