{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-notebook.dev/schemas/artifacts/doc-frontmatter-v1.json",
  "title": "Design Notebook doc frontmatter",
  "type": "object",
  "required": ["formatVersion", "id", "title"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "references": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "additionalProperties": true
}
